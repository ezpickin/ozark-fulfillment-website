---
// Shown by GitHub Pages for any URL that doesn't exist (it serves /404.html).
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { servicePages } from '../data/servicePages';
---

<Layout
  title="Page Not Found — Ozark Fulfillment"
  description="That page doesn't exist. Find Ozark Fulfillment's services or request a quote."
  noindex
>
  <Header />
  <main class="notfound">
    <div class="container">
      <p class="code">404</p>
      <h1>We couldn’t find that page</h1>
      <p class="lede">
        The link may be out of date, or the address may have a typo. Here’s where most people
        are headed:
      </p>

      <ul class="links">
        {
          servicePages.map((p) => (
            <li>
              <a href={`/${p.slug}/`}>{p.name} →</a>
            </li>
          ))
        }
      </ul>

      <div class="ctas">
        <a href="/" class="btn btn-primary">Back to Home</a>
        <a href="/#quote" class="btn btn-ghost">Get a Quote</a>
      </div>

      <p class="help">
        Need a hand? Call <a href="tel:+14174531005">(417) 453-1005</a> or email
        <a href="mailto:trevor@ozarkfulfillment.com">trevor@ozarkfulfillment.com</a>.
      </p>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .notfound {
    padding: 4.5rem 0 5rem;
    text-align: center;
  }

  .notfound .container {
    max-width: 640px;
  }

  .code {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--green);
    margin-bottom: 0.5rem;
  }

  h1 {
    color: var(--navy-800);
    font-size: clamp(1.8rem, 4.5vw, 2.5rem);
    line-height: 1.2;
    margin-bottom: 0.9rem;
  }

  .lede {
    color: var(--ink-soft);
    margin-bottom: 1.75rem;
  }

  .links {
    list-style: none;
    display: grid;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }

  .links a {
    display: block;
    padding: 0.85rem 1rem;
    background: var(--bg-alt);
    border: 1px solid #e2ebf2;
    border-radius: var(--radius);
    color: var(--navy-800);
    font-weight: 600;
    text-decoration: none;
  }

  .links a:hover {
    border-color: var(--water);
    color: var(--water);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .btn-ghost {
    border-color: var(--navy-700);
    color: var(--navy-800);
  }

  .btn-ghost:hover {
    background: var(--sky-light);
  }

  .help {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
</style>
