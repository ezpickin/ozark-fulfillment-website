---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Post-submit confirmation page. QuoteForm.astro redirects here after Web3Forms
// confirms a submission, so /thanks/ page views in Cloudflare Web Analytics
// = successful quote requests. Not linked anywhere, noindexed, and excluded
// from the sitemap so stray visits don't inflate the count.
---
<Layout
  title="Thanks — Ozark Fulfillment"
  description="Your quote request has been received."
  noindex
>
  <Header />
  <main class="thanks">
    <div class="container">
      <h1>Thanks — your request is in.</h1>
      <p class="lede">
        We've received your quote request and will reply within one business day
        (Mon–Fri, 8:00 AM – 4:30 PM CT).
      </p>
      <p>
        Need to reach us sooner? Call <a href="tel:+14174531005">(417) 453-1005</a> or email
        <a href="mailto:trevor@ozarkfulfillment.com">trevor@ozarkfulfillment.com</a>.
      </p>
      <a href="/" class="btn btn-primary back">Back to the home page</a>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .thanks {
    padding: 4.5rem 0 5rem;
  }

  .thanks .container {
    max-width: 760px;
  }

  .thanks h1 {
    color: var(--navy-800);
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    margin-bottom: 1rem;
  }

  .thanks p {
    color: var(--ink-soft);
    margin-bottom: 1rem;
  }

  .thanks .lede {
    font-size: 1.1rem;
    color: var(--ink);
  }

  .thanks p a {
    color: var(--water);
  }

  .back {
    margin-top: 1.5rem;
  }
</style>
