---
// Shared template for the dedicated service pages (src/pages/amazon-fba-prep.astro etc.).
// Each page passes its own copy as props; layout, stats, FAQ, related links and the
// quote form (with the matching service pre-checked) come from here.
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Stats from './Stats.astro';
import QuoteForm from './QuoteForm.astro';
import Footer from './Footer.astro';
import { servicePages, type ServiceSlug } from '../data/servicePages';

interface Item {
  title: string;
  body: string;
}

interface Props {
  slug: ServiceSlug;
  /** <title> and meta description — what shows in Google results */
  title: string;
  description: string;
  /** schema.org serviceType, e.g. "Amazon FBA prep" */
  serviceType: string;
  eyebrow: string;
  h1: string;
  lede: string;
  chips: string[];
  /** optional highlighted notice under the hero */
  callout?: Item;
  includedTitle: string;
  included: Item[];
  steps: Item[];
  faqs: { q: string; a: string }[];
  /** label in QuoteForm's services list to pre-check */
  preselect: string;
}

const {
  slug,
  title,
  description,
  serviceType,
  eyebrow,
  h1,
  lede,
  chips,
  callout,
  includedTitle,
  included,
  steps,
  faqs,
  preselect,
} = Astro.props;

const site = 'https://ozarkfulfillment.com';
const pageName = servicePages.find((p) => p.slug === slug)?.name ?? h1;
const related = servicePages.filter((p) => p.slug !== slug);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType,
    name: pageName,
    description,
    url: `${site}/${slug}/`,
    areaServed: { '@type': 'Country', name: 'United States' },
    provider: {
      '@type': 'LocalBusiness',
      name: 'Ozark Fulfillment',
      url: site,
      telephone: '+1-417-453-1005',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '1475 S Sam Houston Blvd',
        addressLocality: 'Houston',
        addressRegion: 'MO',
        postalCode: '65483',
        addressCountry: 'US',
      },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: 'Services', item: `${site}/#services` },
      { '@type': 'ListItem', position: 3, name: pageName, item: `${site}/${slug}/` },
    ],
  },
];
---

<Layout title={title} description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <Header quoteHref="#quote" />
  <main>
    <section class="svc-hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">›</span>
          <a href="/#services">Services</a>
          <span aria-hidden="true">›</span>
          <span aria-current="page">{pageName}</span>
        </nav>
        <p class="eyebrow">{eyebrow}</p>
        <h1>{h1}</h1>
        <p class="lede">{lede}</p>
        <div class="ctas">
          <a href="#quote" class="btn btn-primary">Get a Quote</a>
          <a href="tel:+14174531005" class="btn btn-outline">Call (417) 453-1005</a>
        </div>
        <ul class="chips">
          {chips.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </section>

    <Stats />

    {
      callout && (
        <section class="callout-wrap">
          <div class="container">
            <div class="callout">
              <h2>{callout.title}</h2>
              <p>{callout.body}</p>
            </div>
          </div>
        </section>
      )
    }

    <section class="included">
      <div class="container">
        <h2 class="section-title">{includedTitle}</h2>
        <div class="grid">
          {
            included.map((i) => (
              <article class="card">
                <svg
                  class="check"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.25"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polyline points="20 6 9 17 4 12" />
                </svg>
                <h3>{i.title}</h3>
                <p>{i.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="steps-section">
      <div class="container">
        <h2 class="section-title">How it works</h2>
        <ol class="steps">
          {
            steps.map((s, idx) => (
              <li>
                <span class="num" aria-hidden="true">
                  {String(idx + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="faq">
      <div class="container">
        <h2 class="section-title">Frequently asked questions</h2>
        <div class="faq-list">
          {
            faqs.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="related">
      <div class="container">
        <h2 class="related-title">More from Ozark Fulfillment</h2>
        <ul>
          {
            related.map((r) => (
              <li>
                <a href={`/${r.slug}/`}>{r.name} →</a>
              </li>
            ))
          }
          <li><a href="/#services">All services →</a></li>
        </ul>
      </div>
    </section>

    <QuoteForm preselect={preselect} />
  </main>
  <Footer />
</Layout>

<style>
  .svc-hero {
    background: linear-gradient(180deg, var(--navy-900) 0%, var(--navy-800) 70%, var(--navy-700) 100%);
    color: #fff;
    padding: 3.5rem 0 4rem;
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: #a9bdd0;
    margin-bottom: 1.5rem;
  }

  .crumbs a {
    color: var(--sky);
    text-decoration: none;
  }

  .crumbs a:hover {
    text-decoration: underline;
  }

  .eyebrow {
    color: var(--sky);
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }

  .svc-hero h1 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.15;
    margin-bottom: 1.1rem;
    max-width: 48rem;
  }

  .lede {
    color: #d4e2ee;
    font-size: 1.1rem;
    max-width: 44rem;
    margin-bottom: 2rem;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
  }

  .chips li {
    border: 1px solid rgba(169, 210, 232, 0.45);
    color: var(--sky);
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
    font-size: 0.85rem;
    font-weight: 500;
  }

  .callout-wrap {
    padding: 3rem 0 0;
  }

  .callout {
    background: var(--sky-light);
    border-left: 5px solid var(--water);
    border-radius: var(--radius);
    padding: 1.5rem 1.75rem;
  }

  .callout h2 {
    color: var(--navy-800);
    font-size: 1.25rem;
    margin-bottom: 0.4rem;
  }

  .callout p {
    color: var(--ink-soft);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .card {
    background: var(--bg-alt);
    border: 1px solid #e2ebf2;
    border-radius: var(--radius);
    padding: 1.5rem 1.6rem;
  }

  .check {
    width: 28px;
    height: 28px;
    color: var(--green);
    margin-bottom: 0.6rem;
  }

  .card h3 {
    color: var(--navy-800);
    font-size: 1.1rem;
    margin-bottom: 0.4rem;
  }

  .card p {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .steps-section {
    background: var(--bg-alt);
  }

  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .steps li {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .num {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--green);
    line-height: 1.2;
  }

  .steps h3 {
    color: var(--navy-800);
    font-size: 1.05rem;
    margin-bottom: 0.3rem;
  }

  .steps p {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .faq-list {
    max-width: 820px;
    margin-top: 1.5rem;
    display: grid;
    gap: 0.75rem;
  }

  details {
    border: 1px solid #d8e3ec;
    border-radius: 10px;
    padding: 1rem 1.25rem;
    background: #fff;
  }

  summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--navy-800);
    list-style-position: outside;
  }

  details[open] summary {
    margin-bottom: 0.5rem;
  }

  details p {
    color: var(--ink-soft);
  }

  .related {
    padding: 0 0 1rem;
  }

  .related-title {
    font-size: 1.1rem;
    color: var(--navy-800);
    margin-bottom: 0.75rem;
  }

  .related ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .related a {
    display: inline-block;
    border: 1px solid #c8d6e2;
    border-radius: 999px;
    padding: 0.45rem 1.1rem;
    color: var(--water);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .related a:hover {
    background: var(--sky-light);
  }
</style>
