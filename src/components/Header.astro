---
import { servicePages } from '../data/servicePages';

interface Props {
  /** Where the "Get a Quote" button goes. Service pages pass '#quote' (their own form). */
  quoteHref?: string;
}
const { quoteHref = '/#quote' } = Astro.props;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/#top" class="brand">
      <span class="logo-badge brand-logo">
        <img src="/logo-128.webp" alt="Ozark Fulfillment logo" width="48" height="48" />
      </span>
      <span class="brand-name">Ozark <span>Fulfillment</span></span>
    </a>

    <nav class="site-nav" id="site-nav" aria-label="Main navigation">
      <!-- "Services" goes to the overview; the submenu links straight to each service page.
           The list comes from src/data/servicePages.ts, so new pages appear automatically. -->
      <div class="nav-group">
        <a href="/#services" class="nav-group-link">
          Services
          <svg class="caret" viewBox="0 0 12 8" width="10" height="7" aria-hidden="true">
            <path d="M1 1.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <ul class="submenu">
          {
            servicePages.map((p) => (
              <li>
                <a href={`/${p.slug}/`}>{p.name}</a>
              </li>
            ))
          }
          <li><a href="/#services">All services</a></li>
        </ul>
      </div>
      <a href="/#why-us">Why Us</a>
      <a href="/#about">About</a>
      <a href="#contact">Contact</a>
      <a href="tel:+14174531005" class="nav-phone">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
        (417) 453-1005
      </a>
      <a href={quoteHref} class="btn btn-primary nav-cta">Get a Quote</a>
    </nav>

    <button class="nav-toggle" id="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="site-nav">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--navy-900);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 72px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-logo {
    width: 48px;
    height: 48px;
  }

  .brand-name {
    color: #fff;
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .brand-name span {
    color: var(--sky);
    font-weight: 500;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  .site-nav a:not(.nav-cta) {
    color: #e6edf4;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .site-nav a:not(.nav-cta):hover {
    color: var(--sky);
  }

  /* ---- Services submenu (desktop: opens on hover or keyboard focus) ---- */
  .nav-group {
    position: relative;
    display: flex;
    align-items: center;
    height: 72px;
  }

  .nav-group-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .caret {
    opacity: 0.8;
  }

  .submenu {
    list-style: none;
    position: absolute;
    top: 64px;
    left: -1rem;
    min-width: 260px;
    padding: 0.5rem;
    background: var(--navy-800);
    border: 1px solid rgba(169, 210, 232, 0.25);
    border-radius: 10px;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.35);
    display: none;
  }

  .nav-group:hover .submenu,
  .nav-group:focus-within .submenu {
    display: block;
  }

  .submenu a {
    display: block;
    padding: 0.6rem 0.8rem;
    border-radius: 6px;
  }

  .submenu a:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  .nav-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600 !important;
  }

  .nav-cta {
    padding: 0.55rem 1.2rem;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .nav-toggle span {
    width: 24px;
    height: 2px;
    background: #fff;
    border-radius: 2px;
  }

  /* Mobile / tablet: everything collapses into the hamburger menu. */
  @media (max-width: 940px) {
    .nav-toggle {
      display: flex;
    }

    .site-nav {
      display: none;
      position: absolute;
      top: 72px;
      left: 0;
      right: 0;
      background: var(--navy-800);
      flex-direction: column;
      align-items: stretch;
      padding: 1rem 1.25rem 1.25rem;
      gap: 0;
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3);
      max-height: calc(100vh - 72px);
      overflow-y: auto;
    }

    .site-nav.open {
      display: flex;
    }

    /* comfortable tap targets */
    .site-nav a:not(.nav-cta) {
      padding: 0.75rem 0;
      font-size: 1rem;
    }

    .nav-group {
      display: block;
      height: auto;
    }

    .caret {
      display: none;
    }

    /* service pages are always listed, indented under "Services" */
    .submenu {
      display: block;
      position: static;
      min-width: 0;
      padding: 0 0 0.25rem 1rem;
      background: none;
      border: none;
      border-left: 2px solid rgba(169, 210, 232, 0.3);
      border-radius: 0;
      box-shadow: none;
    }

    .submenu a {
      padding: 0.6rem 0.75rem !important;
      font-size: 0.95rem !important;
      color: var(--sky) !important;
    }

    .nav-cta {
      margin-top: 0.75rem;
      text-align: center;
      padding: 0.8rem 1.2rem;
      font-size: 1rem;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(!!open));
  });
  // close the mobile menu after a link is tapped
  nav?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      nav.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
    })
  );
</script>
